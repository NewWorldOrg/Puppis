    <IsPackable>true</IsPackable>
    <PackageId>Puppis.Contracts</PackageId>
    <Authors>NewWorldOrg</Authors>
    <Description>The contract between the Carina app and the Puppis driver: the endpoints, events and messages the two exchange over the Unix domain socket.</Description>
