<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <InvariantGlobalization>true</InvariantGlobalization>
    <IsAotCompatible>true</IsAotCompatible>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <IsPackable>true</IsPackable>
    <PackageId>Puppis.Driver</PackageId>
    <Authors>NewWorldOrg</Authors>
    <Description>The Puppis driver as a library, so that the integration tests of an app that speaks Puppis.Contracts can host the driver inside their own process.</Description>
    <PackageLicenseExpression>AGPL-3.0-only</PackageLicenseExpression>
    <PackageProjectUrl>https://github.com/NewWorldOrg/Puppis</PackageProjectUrl>
    <RepositoryUrl>https://github.com/NewWorldOrg/Puppis</RepositoryUrl>
    <RepositoryType>git</RepositoryType>
  </PropertyGroup>

  <ItemGroup>
    <AssemblyAttribute Include="System.Runtime.Versioning.SupportedOSPlatform">
      <_Parameter1>linux</_Parameter1>
    </AssemblyAttribute>
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="../Puppis.Contracts/Puppis.Contracts.csproj" />
  </ItemGroup>

</Project>
